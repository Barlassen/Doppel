# The model gateway (/api/twin) talks to any OpenAI-compatible chat-completions endpoint.
# Without one Doppel runs fully offline: QR decode, local OCR, regex extraction, the what-if parser and the whole
# finance engine need no model. GET /api/twin reports what is connected (host and model names, never the key).

# --- Option 1: OpenRouter (default; AXA gives one key per team) ---
OPENROUTER_API_KEY=
# Optional model overrides (OpenRouter catalogue names)
DOPPEL_TEXT_MODEL=qwen/qwen3-30b-a3b-instruct-2507
DOPPEL_VISION_MODEL=qwen/qwen3-vl-30b-a3b-instruct
# Frontier vision model for the opt-in live, full-image comparison only
DOPPEL_NAIVE_MODEL=openai/gpt-4o

# --- Option 2: any other endpoint (Groq, a local Ollama, LM Studio, vLLM…) ---
# Set the base URL (without /chat/completions) and name the models: the defaults above exist on OpenRouter only.
# A task family without a model stays offline (e.g. no DOPPEL_VISION_MODEL: images fall back to local OCR).
# The OpenRouter key is never sent to another host; use DOPPEL_LLM_API_KEY, or leave it empty for a local server.
#DOPPEL_LLM_BASE_URL=http://localhost:11434/v1
#DOPPEL_LLM_API_KEY=
#DOPPEL_TEXT_MODEL=llama3.2
#DOPPEL_VISION_MODEL=llama3.2-vision
# "off" for servers that reject response_format (otherwise the gateway retries once without it and remembers)
#DOPPEL_LLM_JSON_MODE=off
# Provider timeout in ms (1000–25000, default 15000); local models can be slow on the first call
#DOPPEL_LLM_TIMEOUT_MS=25000

# --- Abuse limits (per server process) ---
# Spending stops for the UTC day at whichever is reached first. 0 switches the gateway off.
DOPPEL_DAILY_BUDGET_USD=1
DOPPEL_DAILY_TOKEN_BUDGET=2000000
# Reverse proxies you run in front of the app. With N > 0 the rate limit is per client (the N-th address from the
# right of X-Forwarded-For); with 0 that header is not trusted and all clients share 60 requests a minute.
# On Vercel the platform header is used automatically.
#DOPPEL_TRUSTED_PROXIES=1
# Extra origins allowed to POST to /api/twin (comma-separated). Same-origin requests always are.
#DOPPEL_ALLOWED_ORIGINS=https://doppel.example
