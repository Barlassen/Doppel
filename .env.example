# OpenRouter key (AXA gives one per team). Without it Doppel runs fully offline with local heuristics.
OPENROUTER_API_KEY=
# Optional model overrides
DOPPEL_TEXT_MODEL=qwen/qwen3-30b-a3b-instruct-2507
DOPPEL_VISION_MODEL=qwen/qwen3-vl-30b-a3b-instruct
# Frontier vision model for the opt-in live, full-image comparison only
DOPPEL_NAIVE_MODEL=openai/gpt-4o
