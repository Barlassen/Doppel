{
  "name": "doppel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "i18n:check": "npx tsx scripts/i18n-check.ts",
    "import:check": "npx tsx scripts/import-check.ts",
    "ubs:build": "npx tsx scripts/build-ubs-data.ts",
    "ubs:check": "npx tsx scripts/ubs-check.ts",
    "play:check": "npx tsx scripts/play-check.ts",
    "api:check": "npx tsx scripts/api-check.ts",
    "engine:check": "npx tsx scripts/engine-check.ts",
    "engine:regression": "npx tsx scripts/engine-regression.ts",
    "play:board": "npx tsx scripts/board-check.ts",
    "lint": "eslint --ignore-pattern \"public/tesseract/runtime/**\" --ignore-pattern \"desktop/.stage/**\" --ignore-pattern \"desktop/dist/**\"",
    "postinstall": "node scripts/copy-tesseract-assets.mjs",
    "smoke:browser": "npx tsx scripts/browser-smoke.mjs",
    "e2e:live": "node scripts/e2e-live.mjs",
    "donut:check": "npx tsx scripts/donut-check.ts",
    "desktop:install": "npm --prefix desktop ci",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:smoke": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "jsqr": "^1.4.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.11.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "playwright": "1.65.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
